{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Wissen.Infrastructure/Wissen.Infrastructure.csproj",
            "Wissen.Web/Wissen.Web.csproj",
            "Wissen.Cli/Wissen.Cli.csproj"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "filterConfig.yml"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "wissen",
      "_appTitle": "wissen",
      "_appFooter": "wissen",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
