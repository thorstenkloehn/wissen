@model Wissen.Infrastructure.Models.SeitenVersion
@{
    // Der Browser-Tab nennt die Überschrift dieses Stands (ohne Überschrift den Pfad), die Seite selbst nur die Nummer.
    ViewData["Title"] = $"{Model.Titel ?? Model.Seite.Path} (Version {Model.Nummer})";
}

<h1>Version @Model.Nummer</h1>
<p>
    Früherer Stand der Seite <a href="/@Model.Seite.Path">@Model.Seite.Path</a>
    vom @Model.ErstelltAm.ToLocalTime().ToString("dd.MM.yyyy HH:mm") von @(Model.Autor ?? "unbekannt")
</p>
@if (Model.MarkdownInhalt != Model.Seite.MarkdownInhalt)
{
    <form asp-action="Zuruecksetzen" asp-route-id="@Model.SeiteId" asp-route-nummer="@Model.Nummer" method="post">
        <button type="submit" class="btn btn-warning">Seite auf diese Version zurücksetzen</button>
    </form>
}
else
{
    <p>Dies ist der aktuelle Stand der Seite.</p>
}
<hr />
@Html.Raw(Model.Inhalt)
<partial name="_Kategorien" model="Model.Kategorien" />
