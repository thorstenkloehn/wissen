@model List<string>
@using Wissen.Web.Controllers
@* Die Kategorien einer Seite oder Version, unter dem Inhalt; ohne Kategorie erscheint nichts. *@
@if (Model.Count > 0)
{
    <p class="border-top pt-2 mt-3">
        <a href="/@KategorieController.Prefix">@(Model.Count == 1 ? "Kategorie" : "Kategorien")</a>:
        @for (var i = 0; i < Model.Count; i++)
        {
            <a href="@KategorieController.Adresse(Model[i])">@Model[i]</a>@(i < Model.Count - 1 ? "," : "")
        }
    </p>
}
