@model Wissen.Infrastructure.Models.Seite?
@{
    // Eine vorhandene Seite bringt ihre Überschrift im Inhalt selbst mit; der Browser-Tab zeigt sie
    // ebenfalls (Seite.Titel), ohne Überschrift den Pfad.
    ViewData["Title"] = Model is null ? "Seite nicht vorhanden" : Model.Titel ?? Model.Path;
    var angemeldet = User.Identity?.IsAuthenticated == true;
}
@if (Model is null)
{
    <h1>@ViewData["Title"]</h1>
    <p>Zu „@ViewData["Path"]“ gibt es noch keine Seite.</p>
    @if (angemeldet && ViewData["PfadGueltig"] is true)
    {
        <p><a asp-controller="Seite" asp-action="Neu" asp-route-path="@ViewData["Path"]">Seite anlegen</a></p>
    }
}
else
{
    @if (Model.Typ == Wissen.Infrastructure.Models.Inhaltstyp.Blogartikel)
    {
        <p class="text-muted">
            <a href="/@Wissen.Web.Controllers.BlogController.Prefix">Blog</a>
            @if (ViewData["VeroeffentlichtAm"] is DateTime datum)
            {
                <text>· </text><time datetime="@datum.ToString("o")">@datum.ToLocalTime().ToString("dd.MM.yyyy")</time>
            }
        </p>
    }
    @Html.Raw(Model.Inhalt)
    <partial name="_Kategorien" model="Model.Kategorien" />
    @if (angemeldet)
    {
        <p>
            <a asp-controller="Seite" asp-action="Bearbeiten" asp-route-id="@Model.Id">Seite bearbeiten</a>
            @if (User.IsInRole(Wissen.Infrastructure.Identity.Rollen.Administrator))
            {
                <text>| </text><a asp-controller="Seite" asp-action="Loeschen" asp-route-id="@Model.Id">Seite löschen</a>
            }
        </p>

        <h2>Versionsgeschichte</h2>
        <ul>
            @foreach (var version in Model.Versionen)
            {
                <li>
                    <a asp-controller="Seite" asp-action="Version" asp-route-id="@Model.Id" asp-route-nummer="@version.Nummer">Version @version.Nummer</a>
                    vom @version.ErstelltAm.ToLocalTime().ToString("dd.MM.yyyy HH:mm") von @(version.Autor ?? "unbekannt")
                </li>
            }
        </ul>
    }
}
