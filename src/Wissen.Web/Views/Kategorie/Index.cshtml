@model List<KategorieAnzahl>
@using Wissen.Web.Controllers
@{
    ViewData["Title"] = "Kategorien";
}

<h1>@ViewData["Title"]</h1>
@if (Model.Count == 0)
{
    <p>Noch keine Seite nennt eine Kategorie. Kategorien stehen im Inhalt einer Seite, z. B. <code>[[Kategorie:Hauptseite]]</code>.</p>
}
else
{
    <ul>
        @foreach (var kategorie in Model)
        {
            <li><a href="@KategorieController.Adresse(kategorie.Name)">@kategorie.Name</a> (@kategorie.Seiten @(kategorie.Seiten == 1 ? "Seite" : "Seiten"))</li>
        }
    </ul>
}
