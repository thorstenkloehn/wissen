@model BlogUebersicht
@using System.Globalization
@using Wissen.Web.Controllers
@{
    ViewData["Title"] = Model.Seite == 1 ? "Blog" : $"Blog – Seite {Model.Seite}";
    var deutsch = CultureInfo.GetCultureInfo("de-DE");
}

@section Head {
    <link rel="alternate" type="application/rss+xml" title="wissen – Blog" href="@BlogController.FeedAdresse" />
}

<h1>@ViewData["Title"]</h1>
<p><a href="@BlogController.FeedAdresse">RSS-Feed</a> mit den neuesten @BlogController.FeedArtikel Artikeln</p>
@if (User.Identity?.IsAuthenticated == true)
{
    <form method="get" asp-controller="Seite" asp-action="Neu" class="row g-2 mb-4">
        <input type="hidden" name="typ" value="@Wissen.Infrastructure.Models.Inhaltstyp.Blogartikel" />
        <div class="col-auto">
            <label for="neuer-artikel" class="visually-hidden">Pfad des neuen Artikels</label>
            <input id="neuer-artikel" name="path" class="form-control" value="blog/" required />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Neuen Artikel schreiben</button>
        </div>
    </form>
}
@if (Model.Artikel.Count == 0)
{
    <p>Noch gibt es keinen Artikel.</p>
}
else
{
    // Nach Monaten gruppiert, die neuesten zuerst; die Reihenfolge kommt schon sortiert aus dem Controller.
    foreach (var monat in Model.Artikel.GroupBy(a => a.VeroeffentlichtAm?.ToLocalTime().ToString("MMMM yyyy", deutsch) ?? "Ohne Datum"))
    {
        <h2 class="h4 mt-4">@monat.Key</h2>
        <ul class="list-unstyled">
            @foreach (var artikel in monat)
            {
                <li class="mb-2">
                    @if (artikel.VeroeffentlichtAm is { } datum)
                    {
                        <time class="text-muted me-2" datetime="@datum.ToString("o")">@datum.ToLocalTime().ToString("dd.MM.yyyy")</time>
                    }
                    <a href="@BlogController.Adresse(artikel.Pfad)">@BlogController.Titel(artikel)</a>
                    @if (artikel.Kategorien.Count > 0)
                    {
                        <small class="text-muted">
                            – @for (var i = 0; i < artikel.Kategorien.Count; i++)
                            {
                                @(i > 0 ? ", " : "")<a href="@KategorieController.Adresse(artikel.Kategorien[i])">@artikel.Kategorien[i]</a>
                            }
                        </small>
                    }
                </li>
            }
        </ul>
    }
}
@if (Model.Seiten > 1)
{
    <nav aria-label="Seiten des Blogs">
        <ul class="pagination flex-wrap">
            <li class="page-item @(Model.Seite == 1 ? "disabled" : "")">
                <a class="page-link" href="@BlogController.UebersichtAdresse(Math.Max(1, Model.Seite - 1))">Neuere</a>
            </li>
            @foreach (var nummer in BlogController.Seitennummern(Model.Seite, Model.Seiten))
            {
                if (nummer is not { } n)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                else if (n == Model.Seite)
                {
                    <li class="page-item active" aria-current="page"><span class="page-link">@n</span></li>
                }
                else
                {
                    <li class="page-item"><a class="page-link" href="@BlogController.UebersichtAdresse(n)">@n</a></li>
                }
            }
            <li class="page-item @(Model.Seite == Model.Seiten ? "disabled" : "")">
                <a class="page-link" href="@BlogController.UebersichtAdresse(Math.Min(Model.Seiten, Model.Seite + 1))">Ältere</a>
            </li>
        </ul>
    </nav>
}
