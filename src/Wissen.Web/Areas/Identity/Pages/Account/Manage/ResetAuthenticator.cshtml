@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Authenticator-Schlüssel zurücksetzen";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Wenn Sie Ihren Authenticator-Schlüssel zurücksetzen, funktioniert Ihre Authenticator-App erst wieder, nachdem Sie sie neu eingerichtet haben.</strong>
    </p>
    <p>
        Dieser Vorgang deaktiviert 2FA, bis Sie Ihre Authenticator-App bestätigt haben.
        Wenn Sie die Einrichtung Ihrer Authenticator-App nicht abschließen, können Sie den Zugriff auf Ihr Konto verlieren.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Authenticator-Schlüssel zurücksetzen</button>
    </form>
</div>
