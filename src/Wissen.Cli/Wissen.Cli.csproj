<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wissen.Infrastructure\Wissen.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Die Konsolenanwendung nutzt dieselbe Konfiguration wie die Web-App. -->
  <ItemGroup>
    <Content Include="..\Wissen.Web\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Wissen.Web\appsettings.json')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

</Project>
