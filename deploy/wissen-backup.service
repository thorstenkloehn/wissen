# Sichert die Datenbank nach /var/lib/wissen/backups. Wird von wissen-backup.timer gestartet.
# Beide Dateien nach /etc/systemd/system/ kopieren, dann:
#   sudo systemctl daemon-reload && sudo systemctl enable --now wissen-backup.timer
# Einmal von Hand sichern: sudo systemctl start wissen-backup && systemctl status wissen-backup
[Unit]
Description=wissen: Sicherung der Datenbank
After=postgresql.service

[Service]
Type=oneshot
User=wissen
EnvironmentFile=/etc/wissen/wissen.env
StateDirectory=wissen
Environment=HOME=/var/lib/wissen
# Die Konsolenanwendung schreibt nach backups/ im Arbeitsverzeichnis.
WorkingDirectory=/var/lib/wissen
# Die Sicherungen enthalten alle Konten und Passwort-Hashes: nur für den Dienstbenutzer lesbar.
UMask=0077
ExecStart=/usr/bin/dotnet /opt/wissen/cli/Wissen.Cli.dll backup
# Nur nach erfolgreicher Sicherung: Sicherungen löschen, die älter als 30 Tage sind.
ExecStartPost=/usr/bin/find /var/lib/wissen/backups -name '*.dump' -mtime +30 -delete

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
