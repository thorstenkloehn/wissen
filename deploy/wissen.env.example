# Einstellungen der Web-App auf dem Server. Kopieren nach /etc/wissen/wissen.env,
# Werte eintragen und die Datei schützen:
#   sudo chown root:root /etc/wissen/wissen.env && sudo chmod 600 /etc/wissen/wissen.env
# Werte stehen in einfachen Anführungszeichen; ein Passwort darf deshalb kein ' enthalten.

ASPNETCORE_ENVIRONMENT='Production'

# Die App lauscht nur lokal; nach außen spricht der Reverse-Proxy (Caddy) per HTTPS.
ASPNETCORE_URLS='http://127.0.0.1:5000'
# Nicht entfernen: Ohne diese Zeile sähe die App nur die Adresse des Proxys, und alle Besucher
# teilten sich die Grenze von 5 Anmeldeversuchen in 5 Minuten.
ASPNETCORE_FORWARDEDHEADERS_ENABLED='true'
ASPNETCORE_HTTPS_PORT='443'

# Nur Anfragen an diese Domain werden beantwortet (mehrere mit ; trennen).
AllowedHosts='IHRE-DOMAIN.de'

# Eigene Datenbankrolle mit eigenem Passwort, nicht das der lokalen Entwicklungsdatenbank.
ConnectionStrings__DefaultConnection='Host=localhost;Port=5432;Database=wissen;Username=wissen;Password=IHR_SERVER_PASSWORT'

# Konten legt die Konsolenanwendung an (Befehl konto-anlegen). Die Registrierung im Browser
# bleibt aus: Ohne E-Mail-Versand ließe sich ein dort angelegtes Konto nicht bestätigen.
RegistrierungErlaubt='false'
